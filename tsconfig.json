{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "lib": ["ES2020", "DOM"],
    "baseUrl": "."
  },
  "include": ["capacitor.config.ts"],
  "exclude": ["node_modules", "dist", "www", "android", "ios"]
}
